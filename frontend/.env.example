# Copy to frontend/.env  (this file is safe to commit, the real .env is not)

# Axios base URL - note the /api/v1 suffix
VITE_API_URL=http://localhost:5000/api/v1

# Socket.io server URL
VITE_WS_URL=ws://localhost:5000

# ESP32 camera JPEG stream URL (e.g. http://<esp32-ip>/photo or http://<esp32-ip>/stream)
VITE_ESP32_CAM_URL=http://<esp32-ip>/photo
