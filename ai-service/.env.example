# Copy to .env (backend/.env is also read automatically as a fallback)

# Embedding model - SFace is the light one: OpenCV ONNX, 128-d, CPU only.
# Other DeepFace models (ArcFace, Facenet512, ...) need TensorFlow - avoid them.
FACE_MODEL=SFace

# Face detector - YuNet is an OpenCV DNN model, fast and light on the CPU.
FACE_DETECTOR=yunet

# Minimum cosine similarity (0-1) to accept a match.
# Leave empty to use DeepFace's own tuned threshold for the model
# (SFace -> 0.407). Raise it to demand a stricter match.
FACE_MATCH_THRESHOLD=

# Frames wider than this are downscaled before inference (lower CPU usage)
FACE_MAX_FRAME_WIDTH=960

# --- accuracy / speed tuning (all optional, defaults are good) -----------------
# YuNet minimum detection score. DeepFace defaults to 0.9 which is too strict for a
# webcam and caused "no face" errors; 0.6 keeps real faces and still rejects junk.
YUNET_SCORE_THRESHOLD=0.6
# Pad the detected box by this % before embedding (tight crops lose accuracy).
FACE_EXPAND_PERCENTAGE=15
# Discard a frame whose face crop is blurrier than this (Laplacian variance).
FACE_MIN_BLUR=25
# Best-vs-runner-up cosine gap required to accept a match.
FACE_MIN_MARGIN=0.04
# Frames sent per scan / per enrolment (frontend captures 3).
FACE_MAX_FRAMES=5
# Templates stored per student (consecutive frames that are not near-duplicates).
FACE_MAX_TEMPLATES=4
# Two enrolment templates more similar than this are treated as the same photo.
FACE_TEMPLATE_DEDUP=0.97
# How long (ms) the normalised gallery is cached before re-reading MongoDB.
# 0 = rebuild on every scan; 3000 = a new registration is visible after ~3s.
FACE_GALLERY_TTL_MS=3000

# Where captured registration photos are stored (served by the Node backend)
FACE_UPLOAD_DIR=../backend/uploads/faces

# Service bind address
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# Falls back to backend/.env MONGODB_URI when not set here
# MONGODB_URI=mongodb://localhost:27017/bus-fee-system
