# Copy to backend/.env  (this file is safe to commit, the real .env is not)

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/bus-fee-system

# Use long random strings in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_long_random_string
JWT_REFRESH_SECRET=change_me_another_long_random_string
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# Frontend origins allowed by CORS (Vite runs on 3000)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Shared secret for the recognition webhook signature
AI_SYSTEM_WEBHOOK_SECRET=change_me

# Rate limiting: 100 requests per 60 s per IP
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Local DeepFace face-recognition service (ai-service/)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=120000

# Fallback coordinates for travel records when no GPS fix is supplied
DEFAULT_LOCATION_LONGITUDE=77.5946
DEFAULT_LOCATION_LATITUDE=12.9716

# ESP32-CAM on the local network - the Node backend proxies it at
# /api/v1/esp32/{health,capture,stream} (the browser cannot reach it directly)
#
# The proxy keeps ONE connection open to the camera and shares it between the
# live video and the face-capture (the CameraWebServer only serves one client),
# reconnecting on its own when the camera drops.
ESP32_CAM_URL=http://192.168.x.x
# How long a TCP connect to the camera may take (ms)
ESP32_CONNECT_TIMEOUT_MS=1500
# How long to wait for a frame from the stream before giving up (ms)
ESP32_FRAME_TIMEOUT_MS=6000
# Delay between automatic reconnect attempts (ms)
ESP32_RECONNECT_DELAY_MS=1000
# Keep the camera warm this long after the last viewer leaves (ms)
ESP32_IDLE_CLOSE_MS=5000
# Still-endpoint fallback timeout for cameras without an MJPEG stream (ms)
ESP32_TIMEOUT_MS=5000
